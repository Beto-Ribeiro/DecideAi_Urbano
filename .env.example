# ==============================================================================
# DECIDEAI — E.E. ENGENHEIRO URBANO ALVES DE SOUZA PEREIRA (TAUBATÉ - SP)
# Configuração de Ambiente (Vercel Hobby + Supabase Free)
# ==============================================================================

# 1. Supabase (Público - usado apenas para leitura de chapas aprovadas quando aplicável)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# 2. Supabase Service Role Key (APENAS NO SERVIDOR — NUNCA use prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-secreta"

# 3. Segredo de Assinatura JWT (jose) para sessões HttpOnly do Admin e Portal da Chapa
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET="gere-um-segredo-aleatorio-de-32-bytes-aqui"

# 4. Credencial do Painel Administrativo (/admin)
# Gere o hash bcrypt com: node -e "require('bcryptjs').hash('SuaSenhaForte', 10).then(console.log)"
ADMIN_PASSWORD_HASH=""
ADMIN_PASSWORD=""

# 5. Segredo opcional para o Vercel Cron diário (/api/health)
CRON_SECRET="segredo-opcional-cron-healthcheck"
